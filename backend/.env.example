# Banco de dados (SQLite para desenvolvimento, PostgreSQL para produção)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/command_analytics"

# JWT Secret (troque para uma string aleatória longa em produção)
JWT_SECRET="command-analytics-secret-2026-troque-em-producao"
JWT_EXPIRES_IN="30d"

# Porta da API
PORT=3333

# Ambiente
NODE_ENV=development

# Credenciais Basic Auth para consultar a API local de cada servidor de nuvem
# (endpoints /api/ready e /api/web/Monitor, usados pelo monitor de servidores)
SERVIDOR_MONITOR_API_USERNAME=
SERVIDOR_MONITOR_API_PASSWORD=
